# ============================================================
#  huaji2-save-editor / .gitignore
#  原则：只在「可重跑生成」和「本机私有」两类上设规则，
#        源码、文档、测试、探针脚本一律入库。
# ============================================================

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------------- 编译 / 打包产物 ----------------
build/
dist/
*.spec

# ---------------- 仓库根的临时暂存区 ----------------
# 打包中转、旧发行包、探针副本……全部可重跑
_tmp/
*.bak.*

# ---------------- 日常工具的本地输出 ----------------
# 脚本自己写的报告/日志（tools/_xxx.txt 之类），跑一次就有
tools/_*
tools/xj_state.txt
tools/re/_*
# 测试跑出来的临时目录（tests/_smoke、tests/_csvtest、tests/_gui……）
tests/_*
_*.txt
_check*.txt
last.txt
error.log
selftest_result.txt

# ---------------- 逆向探针的中间产物 ----------------
# 解出来的游戏明文、内存镜像、爆破日志——体积大、可重跑
probes/_*
probes/_sandbox/
probes/*.exe
probes/0
probes/1
probes/qqeat
probes/xjy.11

# ---------------- 数据表导出 ----------------
# 随时可重导（python src/datatables.py --out csv）；要发布就单独打附件
csv/*
# 但手工整理的《技能关系表》是资产，要入库
!csv/技能关系表.csv

# ---------------- 编辑器 / 系统 ----------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---------------- 提交信息草稿 ----------------
_commit_msg.txt
